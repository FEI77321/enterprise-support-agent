# Enterprise Support Agent 环境变量示例
#
# 如果需要在本地使用环境变量，可以参考本文件创建 .env。
# 注意：不要把真实密钥提交到代码仓库。

# 是否启用 LLM 回答链路。
# false：使用稳定可复现的规则回答，适合 eval 和演示。
# true：知识库高置信命中后，额外调用 llm_client.generate_answer()。
ENABLE_LLM_ANSWER=false

# LLM provider 配置。
# stub：使用本地占位实现，不调用真实模型，适合 eval 和开发。
# openai：通过 backend/app/llm_client.py 调用 OpenAI。
# deepseek：通过 OpenAI 兼容 SDK 调用 DeepSeek。
LLM_PROVIDER=stub

# 仅当 LLM_PROVIDER=openai 时需要配置。
OPENAI_API_KEY=

# llm_client.py 默认使用的 OpenAI 模型。
OPENAI_MODEL=gpt-5

# OpenAI 调用超时时间，单位：秒。
OPENAI_TIMEOUT_SECONDS=20

# DeepSeek Provider 配置。
# 使用 DeepSeek 时设置：
# ENABLE_LLM_ANSWER=true
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# DeepSeek 的 OpenAI 兼容 API 地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认使用速度更快、成本更低的模型。
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek 请求超时时间，单位：秒。
DEEPSEEK_TIMEOUT_SECONDS=20

# 外部 LLM 临时故障（网络超时、429、5xx）的指数退避重试配置。
# 最大次数包含首次调用；鉴权、参数等 4xx 错误不会重试。
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=4

# Agent 编排引擎：rules（if/else 路由）/ langgraph（显式状态图路由）。
# 两者输出行为一致，langgraph 版为状态图实现，便于扩展与可视化。
AGENT_ENGINE=rules

# Agent Harness 运行时治理：默认开启；设为 false 可回退到旧工具调用路径。
# max_steps 是单次请求允许执行的真实工具调用上限。
AGENT_HARNESS_ENABLED=true
AGENT_HARNESS_MAX_STEPS=4

# Redis 基础设施开关。直接运行 start.ps1 时默认关闭，不依赖本机 Redis；
# docker compose 启动时会覆盖为 true，并连接 compose 内的 redis 服务。
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Redis 分布式限流。默认关闭，容器模式会自动启用。
# 固定窗口：每个客户端 IP 在 60 秒内最多 60 次受保护接口请求。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Redis 短暂故障时 true=保障业务可用性并放行；false=返回服务错误。
RATE_LIMIT_FAIL_OPEN=true

# 工具调用规划 provider：
# mock：本地规则占位，适合 eval 与离线开发。
# deepseek：Prompt 驱动 JSON 计划（模型输出自由文本后解析）。
# deepseek_native：原生 function calling（tools 参数 + 结构化 tool_calls）。
TOOL_CALL_PROVIDER=mock
