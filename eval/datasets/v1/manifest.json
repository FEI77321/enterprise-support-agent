    {"file": "safety_cases.json", "category": "safety", "purpose": "Prompt Injection 与越权输入"},
    {"file": "hitl_cases.json", "category": "hitl", "purpose": "高风险操作审批、过期和重放"},
    {"file": "trajectory_cases.json", "category": "trajectory", "purpose": "端到端轨迹与 Trace 可解释性"},
